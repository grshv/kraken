{
  "openapi": "3.1.1",
  "info": {
    "title": "Squid Control API",
    "version": "0.3.0",
    "description": "Critical-path API implemented in the first development slice. Full-draft editing is initial interface; later CRUD, users and retention APIs require explicit extension. Errors include 400 invalid input, 401 unauthenticated, 403 CSRF/authorization, 404 unknown resource, 409 conflict/busy, 422 policy/capability failure, 429 throttled, 503 unavailable. All responses containing session/config data use Cache-Control: no-store. Origin is checked on mutations in addition to CSRF. Visual settings and guarded expert mode, general clients, revision history/diff and rollback are supported. Password reset is local CLI only, never a public recovery endpoint."
  },
  "servers": [
    {
      "url": "https://control.example.test/api/v1",
      "description": "Illustrative origin only"
    }
  ],
  "security": [
    {
      "sessionCookie": []
    }
  ],
  "paths": {
    "/session": {
      "get": {
        "operationId": "getSession",
        "summary": "Get session state and CSRF token",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [],
        "security": [],
        "description": "Creates bounded pre-auth CSRF context if unauthenticated. Response is Cache-Control: no-store."
      },
      "post": {
        "operationId": "login",
        "summary": "Log in",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Same-origin session-bound token. Login uses pre-auth token from GET /session."
          }
        ],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "description": "Validates pre-auth CSRF and allowed Origin; sets Secure HttpOnly SameSite cookie; throttled."
      },
      "delete": {
        "operationId": "logout",
        "summary": "Revoke session",
        "responses": {
          "204": {
            "description": "No content"
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Same-origin session-bound token. Login uses pre-auth token from GET /session."
          }
        ]
      }
    },
    "/status": {
      "get": {
        "operationId": "getStatus",
        "summary": "Observe control and data plane separately",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": []
      }
    },
    "/configuration/draft": {
      "get": {
        "operationId": "getDraft",
        "summary": "Read full desired configuration",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draft"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": []
      },
      "put": {
        "operationId": "updateDraft",
        "summary": "Replace draft with optimistic concurrency",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Draft"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Same-origin session-bound token. Login uses pre-auth token from GET /session."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateDraft"
              }
            }
          }
        },
        "description": "Atomic update; expected_version mismatch returns 409. CIDR overlap and references revalidated in transaction. Does not apply traffic changes."
      }
    },
    "/revisions": {
      "post": {
        "operationId": "createRevision",
        "summary": "Freeze a draft snapshot",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Same-origin session-bound token. Login uses pre-auth token from GET /session."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRevision"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "listRevisions",
        "summary": "Read latest 100 revision summaries and rollback eligibility",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RevisionSummary"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/revisions/{id}": {
      "get": {
        "operationId": "getRevision",
        "summary": "Read immutable revision",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Revision"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/revisions/{id}/preview": {
      "get": {
        "operationId": "previewRevision",
        "summary": "Preview generated configuration and semantic diff",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Preview"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/operations": {
      "post": {
        "operationId": "createOperation",
        "summary": "Validate, apply or roll back a revision",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 128
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Same-origin session-bound token. Login uses pre-auth token from GET /session."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OperationRequest"
              }
            }
          }
        },
        "description": "Creates a durable SQLite operation intent before the in-process worker runs. 409 for conflicting key/revision; busy is explicit. Apply requires validated exact inputs. Rollback uses the local Squid adapter and is verified. No separate runner or Docker API."
      }
    },
    "/operations/{id}": {
      "get": {
        "operationId": "getOperation",
        "summary": "Read durable operation status",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Operation"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "Read bounded, sanitized proxy events",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventPage"
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          },
          {
            "name": "client_id",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "failures_only",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "description": "No arbitrary path or shell filter. Tunnel events do not reveal origin URL path or status. Unknown historical revision stays null. First slice returns a bounded tail with gap=true and no cursor; cursor/client_id filters return 422. Unknown historical client/revision remains null."
      }
    },
    "/certificates": {
      "get": {
        "operationId": "listCertificates",
        "summary": "Read public certificate metadata",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Certificate"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error; code is stable, message safe for UI.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [],
        "description": "Returns installed inventory metadata, never private keys; local provisioning only in first version."
      }
    },
    "/configuration/expert-template": {
      "get": {
        "operationId": "getExpertTemplate",
        "summary": "Generate editable user section from saved structured rules without changing mode",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "expert_config": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "expert_config"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          },
          "operation_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "authenticated",
          "username",
          "csrf_token",
          "expires_at"
        ],
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "csrf_token": {
            "type": "string"
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "writeOnly": true
          }
        }
      },
      "Destination": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "include_subdomains"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "description": "Canonical ASCII domain; no scheme/path/glob/CRLF."
          },
          "include_subdomains": {
            "type": "boolean"
          }
        }
      },
      "Client": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "source_networks",
          "enabled",
          "policy_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 1024
          },
          "source_networks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "policy_id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "host",
              "network",
              "group"
            ],
            "description": "Client metadata; not tied to virtualization."
          }
        }
      },
      "Policy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "mode",
          "destinations",
          "tls_profile_id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "mode": {
            "type": "string",
            "enum": [
              "all_web",
              "allowlist"
            ]
          },
          "destinations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Destination"
            }
          },
          "tls_profile_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TLSProfile": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "mode",
          "proxy_transport",
          "cert_ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "mode": {
            "type": "string",
            "enum": [
              "tunnel"
            ]
          },
          "proxy_transport": {
            "type": "string",
            "enum": [
              "http",
              "tls"
            ]
          },
          "cert_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ConfigurationSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema_version",
          "clients",
          "policies",
          "tls_profiles"
        ],
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1
          },
          "clients": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Client"
            }
          },
          "policies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Policy"
            }
          },
          "tls_profiles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TLSProfile"
            }
          },
          "settings": {
            "$ref": "#/components/schemas/SquidSettings"
          },
          "configuration_mode": {
            "type": "string",
            "enum": [
              "structured",
              "expert"
            ],
            "default": "structured"
          },
          "expert_config": {
            "type": "string",
            "maxLength": 131072,
            "description": "User squid.conf section. Managed runtime directives, includes and executable helpers prohibited; validate with real Squid before apply."
          }
        }
      },
      "Draft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "snapshot",
          "updated_at"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "snapshot": {
            "$ref": "#/components/schemas/ConfigurationSnapshot"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateDraft": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_version",
          "snapshot"
        ],
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 1
          },
          "snapshot": {
            "$ref": "#/components/schemas/ConfigurationSnapshot"
          }
        }
      },
      "CreateRevision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "expected_draft_version"
        ],
        "properties": {
          "expected_draft_version": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "Revision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "draft_version",
          "policy_hash",
          "compiler_version",
          "image_digest",
          "created_at",
          "snapshot"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "draft_version": {
            "type": "integer",
            "minimum": 1
          },
          "policy_hash": {
            "type": "string"
          },
          "compiler_version": {
            "type": "string"
          },
          "image_digest": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "snapshot": {
            "$ref": "#/components/schemas/ConfigurationSnapshot"
          }
        }
      },
      "Preview": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision_id",
          "policy_hash",
          "summary",
          "generated_config",
          "warnings",
          "expected_applied_revision",
          "config_diff"
        ],
        "properties": {
          "revision_id": {
            "type": "string",
            "format": "uuid"
          },
          "policy_hash": {
            "type": "string"
          },
          "summary": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generated_config": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_applied_revision": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "config_diff": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DiffLine"
            }
          }
        }
      },
      "ValidateRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "revision_id",
          "expected_applied_revision"
        ],
        "properties": {
          "action": {
            "const": "validate",
