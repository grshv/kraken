# Compose reads defaults here if copied to .env in repository root.
SC_PUBLIC_ORIGIN=https://localhost:8443
SC_MANAGEMENT_BIND=127.0.0.1
SC_PROXY_BIND=127.0.0.1
# Optional TLS proxy override; absolute paths, readable by container UID 13.
# SC_PROXY_CERT_FILE=/absolute/path/proxy.crt
# SC_PROXY_KEY_FILE=/absolute/path/proxy.key
# Runtime defaults: /data/app/control.sqlite3, /data/runtime, /data/logs/access.log.
# Panel defaults: /data/certs/panel.crt + panel.key. Never inline key/password values.
