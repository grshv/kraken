# Compose reads defaults here if copied to .env in repository root.
# Image to run; default is the local build. Published: ghcr.io/grshv/kraken:main.
# KRAKEN_IMAGE=ghcr.io/grshv/kraken:main
KRAKEN_PUBLIC_ORIGIN=https://localhost:8443
KRAKEN_MANAGEMENT_BIND=127.0.0.1
KRAKEN_PROXY_BIND=127.0.0.1
# Optional TLS proxy override; absolute paths, readable by container UID 13.
# KRAKEN_PROXY_CERT_FILE=/absolute/path/proxy.crt
# KRAKEN_PROXY_KEY_FILE=/absolute/path/proxy.key
# State lives in the volume /var/lib/kraken (data/, certs/, log/); derived files
# are rebuilt in tmpfs /dev/shm/kraken. Never inline key/password values here.
