# Compose reads .env next to compose.yaml: deploy/.env in the repository,
# or .env beside a downloaded compose.yaml. Never put keys or passwords here.

# Image; local build: kraken:dev, fixed version: sha-<commit>.
# KRAKEN_IMAGE=kraken:dev

# Where the panel is opened; its host goes into the certificate.
KRAKEN_PUBLIC_ORIGIN=https://localhost:8443

# Host address for the panel (8443) and for the proxy (3128 HTTP, 3129 TLS).
KRAKEN_MANAGEMENT_BIND=127.0.0.1
KRAKEN_PROXY_BIND=127.0.0.1

# Extra certificate names (DNS or IP) clients use, e.g. a proxy DNS name.
# KRAKEN_CERT_NAMES=proxy.corp.example

# Host directory instead of the named volume (empty or a Kraken copy).
# KRAKEN_DATA=./data
