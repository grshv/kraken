# Design placeholders only: runtime env parser/Compose are not implemented.
# One container: Pebble + Squid + Go with embedded UI; no host runner/socket.
# No passwords, tokens, signing CA keys or TLS private keys belong here.
SC_PUBLIC_ORIGIN=https://control.example.test
SC_PANEL_LISTEN=:8443
SC_PROXY_HOST=proxy.example.test
SC_HTTP_PROXY_PORT=3128
SC_TLS_PROXY_PORT=3129
SC_DATABASE_PATH=/var/lib/squid-control/app/control.sqlite3
SC_RUNTIME_STATE_DIR=/var/lib/squid-control/runtime
# Set final application image digest in Compose after build/capability checks.
SC_IMAGE=
# Canonical base tag+digest is pinned in the future Dockerfile/build manifest.
# Secret file references will be specified by deployment, not inline values.
